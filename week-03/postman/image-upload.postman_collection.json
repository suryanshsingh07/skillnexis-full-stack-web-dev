{
  "info": {
    "name": "SkillNexis Week 3 - Multer Image Upload API",
    "description": "Assignment 2 — Image Upload Feature using Multer with MIME validation and 5MB size limit",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Health Check",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{uploadBaseUrl}}/api/health",
          "host": [
            "{{uploadBaseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      }
    },
    {
      "name": "2. Upload Single Image (multipart/form-data)",
      "request": {
        "method": "POST",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "image",
              "type": "file",
              "description": "Select JPEG, PNG, or WebP image under 5MB"
            }
          ]
        },
        "url": {
          "raw": "{{uploadBaseUrl}}/api/uploads/image",
          "host": [
            "{{uploadBaseUrl}}"
          ],
          "path": [
            "api",
            "uploads",
            "image"
          ]
        }
      }
    },
    {
      "name": "3. Get All Uploaded Images",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{uploadBaseUrl}}/api/uploads",
          "host": [
            "{{uploadBaseUrl}}"
          ],
          "path": [
            "api",
            "uploads"
          ]
        }
      }
    },
    {
      "name": "4. Missing File Validation Error Test",
      "request": {
        "method": "POST",
        "body": {
          "mode": "formdata",
          "formdata": []
        },
        "url": {
          "raw": "{{uploadBaseUrl}}/api/uploads/image",
          "host": [
            "{{uploadBaseUrl}}"
          ],
          "path": [
            "api",
            "uploads",
            "image"
          ]
        }
      }
    }
  ]
}