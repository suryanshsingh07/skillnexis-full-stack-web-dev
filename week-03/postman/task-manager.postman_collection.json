{
  "info": {
    "name": "SkillNexis Week 3 - Mini Project Task Manager API",
    "description": "Mini Project — Complete Task Manager API with JWT, Priority, Status, Due Dates, and Ownership Isolation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Health Check",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{tmBaseUrl}}/api/health",
          "host": [
            "{{tmBaseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      }
    },
    {
      "name": "2. Register User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "    const json = pm.response.json();",
              "    if (json.token) pm.environment.set('token', json.token);",
              "    if (json.user && json.user.id) pm.environment.set('userId', json.user.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Suryansh Singh\",\n  \"email\": \"suryansh.tm@example.com\",\n  \"password\": \"Password123\"\n}"
        },
        "url": {
          "raw": "{{tmBaseUrl}}/api/auth/register",
          "host": [
            "{{tmBaseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      }
    },
    {
      "name": "3. Login User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    const json = pm.response.json();",
              "    if (json.token) pm.environment.set('token', json.token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"suryansh.tm@example.com\",\n  \"password\": \"Password123\"\n}"
        },
        "url": {
          "raw": "{{tmBaseUrl}}/api/auth/login",
          "host": [
            "{{tmBaseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "4. Create High Priority Task",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "    const json = pm.response.json();",
              "    if (json.task && json.task._id) pm.environment.set('taskId', json.task._id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Implement Task Manager Dashboard\",\n  \"description\": \"Finish React + Express + MongoDB integration with filters and stats\",\n  \"status\": \"in-progress\",\n  \"priority\": \"high\",\n  \"dueDate\": \"2026-10-23T13:53:27.073Z\"\n}"
        },
        "url": {
          "raw": "{{tmBaseUrl}}/api/tasks",
          "host": [
            "{{tmBaseUrl}}"
          ],
          "path": [
            "api",
            "tasks"
          ]
        }
      }
    },
    {
      "name": "5. Get Tasks & Statistics",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{tmBaseUrl}}/api/tasks",
          "host": [
            "{{tmBaseUrl}}"
          ],
          "path": [
            "api",
            "tasks"
          ]
        }
      }
    },
    {
      "name": "6. Filter Tasks by Status & Priority",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{tmBaseUrl}}/api/tasks?status=in-progress&priority=high",
          "host": [
            "{{tmBaseUrl}}"
          ],
          "path": [
            "api",
            "tasks"
          ],
          "query": [
            {
              "key": "status",
              "value": "in-progress"
            },
            {
              "key": "priority",
              "value": "high"
            }
          ]
        }
      }
    },
    {
      "name": "7. Update Task Status to Completed",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"completed\"\n}"
        },
        "url": {
          "raw": "{{tmBaseUrl}}/api/tasks/{{taskId}}",
          "host": [
            "{{tmBaseUrl}}"
          ],
          "path": [
            "api",
            "tasks",
            "{{taskId}}"
          ]
        }
      }
    },
    {
      "name": "8. Delete Task",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{tmBaseUrl}}/api/tasks/{{taskId}}",
          "host": [
            "{{tmBaseUrl}}"
          ],
          "path": [
            "api",
            "tasks",
            "{{taskId}}"
          ]
        }
      }
    }
  ]
}