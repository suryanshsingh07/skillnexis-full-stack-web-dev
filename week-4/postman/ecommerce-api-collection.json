    {
      "name": "Products & Catalog",
      "item": [
        {
          "name": "Get All Products (with filters)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.products && res.products.length > 0) {",
                  "    pm.environment.set('productId', res.products[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?search=&category=all&sort=newest&page=1&limit=12",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "search", "value": "" },
                { "key": "category", "value": "all" },
                { "key": "sort", "value": "newest" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "12" }
              ]
            }
          },
          "response": []
        },
