    {
      "name": "Orders & Authoritative Checkout",
      "item": [
        {
          "name": "Create Order (Authoritative Checkout)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.order) {",
                  "    pm.environment.set('orderId', res.order._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderItems\": [\n    {\n      \"product\": \"{{productId}}\",\n      \"quantity\": 1\n    }\n  ],\n  \"shippingAddress\": {\n    \"fullName\": \"Suryansh Singh\",\n    \"street\": \"42 Gomti Nagar\",\n    \"city\": \"Lucknow\",\n    \"state\": \"Uttar Pradesh\",\n    \"postalCode\": \"226010\",\n    \"phone\": \"9876543210\"\n  },\n  \"paymentMethod\": \"demo_card\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            }
          },
          "response": []
        },
