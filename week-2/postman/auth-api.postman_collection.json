{
  "info": {
    "_postman_id": "b2c3d4e5-f6a7-8b9c-0d1e-2f3a4b5c6d7e",
    "name": "SkillNexis Week 2 — User Authentication API",
    "description": "Comprehensive Postman test collection for User Authentication REST API covering registration, bcrypt hashing, JWT issuance, and protected user endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl_auth}}/api/health",
          "host": ["{{baseUrl_auth}}"],
          "path": ["api", "health"]
        }
      },
      "response": []
    },
    {
      "name": "02. Register User (Stores authToken in Environment)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "pm.test('Status code is 201', () => pm.response.to.have.status(201));",
              "if (res.token) {",
              "    pm.environment.set('authToken', res.token);",
              "    console.log('Saved authToken from registration');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Suryansh Singh\",\n  \"email\": \"suryansh.dev@example.com\",\n  \"password\": \"SecurePass2026!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl_auth}}/api/auth/register",
          "host": ["{{baseUrl_auth}}"],
          "path": ["api", "auth", "register"]
        }
      },
      "response": []
    },
    {
      "name": "03. Login User (Updates authToken in Environment)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
              "if (res.token) {",
              "    pm.environment.set('authToken', res.token);",
              "    console.log('Saved authToken from login');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"suryansh.dev@example.com\",\n  \"password\": \"SecurePass2026!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl_auth}}/api/auth/login",
          "host": ["{{baseUrl_auth}}"],
          "path": ["api", "auth", "login"]
        }
      },
      "response": []
    },
    {
      "name": "04. Get Current User Profile (Protected - Bearer Token)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl_auth}}/api/auth/me",
          "host": ["{{baseUrl_auth}}"],
          "path": ["api", "auth", "me"]
        }
      },
      "response": []
    },
    {
      "name": "05. Error: Duplicate Email Registration (Expect 400)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Suryansh Singh Duplicate\",\n  \"email\": \"suryansh.dev@example.com\",\n  \"password\": \"AnotherPassword123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl_auth}}/api/auth/register",
          "host": ["{{baseUrl_auth}}"],
          "path": ["api", "auth", "register"]
        }
      },
      "response": []
    },
    {
      "name": "06. Error: Weak Password Under 6 Chars (Expect 400)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Weak User\",\n  \"email\": \"weak@example.com\",\n  \"password\": \"123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl_auth}}/api/auth/register",
          "host": ["{{baseUrl_auth}}"],
          "path": ["api", "auth", "register"]
        }
      },
      "response": []
    },
    {
      "name": "07. Error: Login with Wrong Password (Expect 401)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"suryansh.dev@example.com\",\n  \"password\": \"IncorrectPassword999\"\n}"
        },
        "url": {
          "raw": "{{baseUrl_auth}}/api/auth/login",
          "host": ["{{baseUrl_auth}}"],
          "path": ["api", "auth", "login"]
        }
      },
      "response": []
    },
    {
      "name": "08. Error: Protected Route with Missing Token (Expect 401)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl_auth}}/api/auth/me",
          "host": ["{{baseUrl_auth}}"],
          "path": ["api", "auth", "me"]
        }
      },
      "response": []
    },
    {
      "name": "09. Error: Protected Route with Invalid Token (Expect 401)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer fake_tampered_token_xyz" }
        ],
        "url": {
          "raw": "{{baseUrl_auth}}/api/auth/me",
          "host": ["{{baseUrl_auth}}"],
          "path": ["api", "auth", "me"]
        }
      },
      "response": []
    }
  ]
}
