        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"MERN Stack Architecture Notes (Revised)\",\n  \"tags\": [\"Architecture\", \"MERN\", \"BestPractices\"]\n}"
