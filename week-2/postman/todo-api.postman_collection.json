    {
      "name": "02. Create Task (Stores taskId in Environment)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "pm.test('Status code is 201', () => pm.response.to.have.status(201));",
              "if (res.data && res.data._id) {",
              "    pm.environment.set('taskId', res.data._id);",
              "    console.log('Saved taskId:', res.data._id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Complete SkillNexis Week 2 Assignment\",\n  \"description\": \"Build React fundamentals app and three Express REST APIs with tests and Postman collections.\",\n  \"completed\": false\n}"
        },
        "url": {
